{
  "name": "@zakkster/lite-profiler",
  "version": "1.6.0",
  "description": "Zero-GC frame profiler: per-phase timing, deterministic counters, percentiles, frame classifier, .litecap binary capture, regression gating, and opt-in absolute-timeline capture for flame charts.",
  "type": "module",
  "main": "./index.js",
  "module": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "node": "./index.js",
      "import": "./index.js",
      "default": "./index.js"
    }
  },
  "bin": {
    "litecap": "./bin/Litecap.mjs"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "src/",
    "bin/",
    "README.md",
    "CHANGELOG.md",
    "llms.txt",
    "LICENSE.txt"
  ],
  "scripts": {
    "test": "node --test",
    "pack": "npm pack --dry-run",
    "bundle-check": "npx esbuild index.js --bundle --format=esm --external:@zakkster/* --outfile=test-bundle.js",
    "prepublishOnly": "npm run test && npm run bundle-check"
  },
  "keywords": [
    "profiler",
    "frame-time",
    "fps",
    "telemetry",
    "gc",
    "zero-gc",
    "percentile",
    "histogram",
    "game-loop",
    "performance",
    "ring-buffer",
    "oscilloscope",
    "lite-tools",
    "timeline",
    "flamechart",
    "flame-chart",
    "trace",
    "perfetto"
  ],
  "dependencies": {
    "@zakkster/lite-canvas-graph": "^1.0.1",
    "@zakkster/lite-ring-buffer": "^1.0.1",
    "@zakkster/lite-stats-math": "^1.0.1"
  },
  "devDependencies": {
    "@zakkster/lite-scope": "^1.1.0",
    "esbuild": "^0.24.0",
    "typescript": "^7.0.2"
  },
  "license": "MIT",
  "author": "Zahary Shinikchiev <shinikchiev@yahoo.com>",
  "homepage": "https://github.com/PeshoVurtoleta/lite-profiler#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PeshoVurtoleta/lite-profiler.git"
  },
  "bugs": {
    "url": "https://github.com/PeshoVurtoleta/lite-profiler/issues",
    "email": "shinikchiev@yahoo.com"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/PeshoVurtoleta"
  },
  "sideEffects": false
}
